# Copia este archivo a .env.local y rellena los valores
# En producción, las credenciales se guardan en la pantalla de Configuración
# Este archivo solo se usa en desarrollo

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Cuenta de servicio del desktop (migración 014)
# Crear en Supabase → Authentication → Users con user_metadata: {"role":"desktop"}
# Si está vacío, la app usa la anon key + RLS de migración 012 como fallback
VITE_DESKTOP_EMAIL=desktop@garum.local
VITE_DESKTOP_PASSWORD=
