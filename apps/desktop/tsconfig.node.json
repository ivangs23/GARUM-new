{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "CommonJS",
    "moduleResolution": "node",
    "strict":           true,
    "skipLibCheck":     true,
    "outDir":           "dist",
    "baseUrl":          ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@garum/shared/order-routing": ["../../packages/shared/src/order-routing.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
