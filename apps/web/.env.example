# Web — variables de entorno requeridas en producción.
# Copia este archivo como `.env.local` y rellena cada valor.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL y anon key (`Project Settings → API` en Supabase Dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SOLO en el servidor (webhook, server actions admin).
# Nunca commit-ear este valor ni exponerlo al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Publishable key — segura para enviar al cliente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key + webhook secret — server-only. Si faltan al arrancar, las rutas
# /api/checkout, /api/payment-intent y /api/webhook lanzan en module-load
# (`lib/env.ts` → requireServerEnv).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── URL pública del sitio ────────────────────────────────────────────────────
# Stripe Checkout redirige a `${NEXT_PUBLIC_APP_URL}/success?...` tras el pago.
# En producción es OBLIGATORIA: sin ella `/api/checkout` devuelve 500.
# En desarrollo si está vacía cae al `origin` del request o a `http://localhost:3001`.
NEXT_PUBLIC_APP_URL=

# ── Sentry (opcional) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
