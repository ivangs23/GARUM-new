{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "test:integration": "node --experimental-strip-types --env-file=.env.local --test tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=public --project=public-mobile",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@garum/shared": "workspace:*",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
